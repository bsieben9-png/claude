{
  "manifest_version": 3,
  "name": "Calmar Menu Tracker",
  "version": "1.0.1",
  "description": "Tracks the Country Cannabis Calmar menu from your computer: best value, new arrivals, price drops, ratings, watchlist and matched product photos.",
  "action": {
    "default_title": "Open Calmar Menu Tracker",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": [
    "https://ecom-api.blaze.me/*",
    "https://*.imgix.net/*",
    "https://ocs.ca/*",
    "https://cdn.shopify.com/*"
  ]
}
